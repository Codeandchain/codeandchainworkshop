# ════════════════════════════════════════════════════════════════
#  Démo Bitnob Lightning — variables d'environnement (exemple)
#  Copie :  cp .env.example .env
#  Le mode simulation (MOCK_PAYMENTS=true) fonctionne SANS aucune
#  clé Bitnob : parfait pour préparer le workshop.
# ════════════════════════════════════════════════════════════════

# ── Mode simulation (true = aucun argent réel) ─────────────────
MOCK_PAYMENTS=true
# Délai (ms) avant qu'une facture fictive soit "payée" automatiquement
MOCK_PAYMENT_DELAY_MS=2000
# Durée de validité d'une facture (secondes)
INVOICE_EXPIRY_S=600

# ── Bitnob (sandbox) ────────────────────────────────────────────
#  L'API Bitnob s'authentifie par HMAC avec un Client ID et une
#  Secret Key générés dans : Dashboard  Settings  API Keys.
#  Sandbox et production partagent la même URL : seule la clé change.
BITNOB_BASE_URL=https://api.bitnob.com
BITNOB_CLIENT_ID=
BITNOB_SECRET_KEY=
# Secret du webhook (signing secret renvoyé à la création du webhook).
# Sert à VÉRIFIER la signature x-bitnob-signature reçue.
BITNOB_WEBHOOK_SECRET=

# ── Protection (OBLIGATOIRE avant de mettre en ligne) ──────────
# Code exigé (en-tête x-admin-token) pour le payout, le fil des
# échanges, le journal et les outils de démo. L'interface le demande.
# Avec MOCK_PAYMENTS=false et sans ADMIN_TOKEN, le payout est REFUSÉ.
# Génère-en un :  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=
# false = coupe le fil des échanges et le rejeu de webhook (vraie prod)
DEMO_TOOLS=true

# ── Serveur ─────────────────────────────────────────────────────
PORT=3000
# URL publique du serveur (pour afficher l'URL du webhook à configurer)
PUBLIC_URL=http://localhost:3000
